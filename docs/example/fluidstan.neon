parameters:
    environment: FluidStan\TYPO3\Typo3Environment
    bootstrapFiles:
        - ../../vendor/autoload.php
    paths:
        - EXT:shop/Resources/Private/Components
        - EXT:shop/Resources/Private/Elements
    namespaces:
        # TYPO3 14 registers it globally through Configuration/Fluid/Namespaces.php; TYPO3 13 needs it here
        shop: Vendor\Shop\Components\ComponentCollection
    tmpDir: ../../.cache/fluidstan-example
